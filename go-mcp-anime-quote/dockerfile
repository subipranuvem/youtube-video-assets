# Stage 1: compile the Go source code into a binary using the official Go image.
FROM golang:1.25.6-alpine AS builder

ARG GOOS=darwin
ARG GOARCH=arm64

WORKDIR /app
COPY . .
RUN go mod download
RUN CGO_ENABLED=0 GOOS=${GOOS} GOARCH=${GOARCH} go build -o go-mcp-anime-quote main.go

# Stage 2: copy only the compiled binary into an empty image to keep it minimal.
FROM alpine:3.21
WORKDIR /app
COPY --from=builder /app/go-mcp-anime-quote .
CMD ["./go-mcp-anime-quote"]